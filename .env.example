# ReceiptTrust backend configuration (example).
# Copy to `.env` and adjust for your environment. `.env` is git-ignored.
# All values below are the defaults from application.yml unless noted.

# ---- Database (PostgreSQL) ----
# Local Docker Postgres runs on host port 5433 (see docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5433/receipttrust
DB_USERNAME=receipttrust
DB_PASSWORD=receipttrust
#
# --- Supabase (managed Postgres) ---
# In the Supabase dashboard: Connect -> "Session pooler" (NOT Transaction pooler,
# NOT Direct). Session pooler is reachable over IPv4 (works on Render free tier)
# and keeps per-session features Hibernate/Flyway rely on.
# The username is "postgres.<project-ref>", the db name is "postgres", and SSL is
# required. Convert the pooler string to JDBC form:
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<your-supabase-db-password>

# ---- Server ----
SERVER_PORT=8080

# ---- JWT (CHANGE THE SECRET IN PRODUCTION) ----
# Must be a Base64-encoded HMAC-SHA256 key (>= 32 bytes when decoded).
# Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1kZXYtb25seS1zZWNyZXQtMzJieXRlcyE=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# ---- File storage (receipt/profile images) ----
RECEIPT_DIR=./storage/receipts
PROFILE_DIR=./storage/profiles
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB

# ---- Debt terms ----
DEBT_TERM_DAYS=14

# ---- OCR (Tesseract) ----
OCR_ENABLED=true
TESSDATA_PATH=./tessdata
OCR_LANGUAGE=eng

# ---- CORS: allowed browser origins (comma-separated) ----
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Social login (optional; features stay disabled until set) ----
# Google OAuth Web client id (public; safe to expose). Backend verifies ID tokens
# against this audience, frontend renders the Google button when it's set.
GOOGLE_CLIENT_ID=
# Facebook is prepared but not implemented yet; needs an app id + secret.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Frontend (Vite) ----
# Only needed for production static hosting; in dev the Vite proxy handles /api.
# VITE_API_BASE_URL=https://your-api.onrender.com
# Google client id for the frontend button (same value as GOOGLE_CLIENT_ID).
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
